import java.util.*;

public class CompetitivePatterns {

    // 1. Two Pointers
    static boolean twoSum(int[] arr, int target) {
        Arrays.sort(arr);

        int left = 0;
        int right = arr.length - 1;

        while (left < right) {
            int sum = arr[left] + arr[right];

            if (sum == target) {
                return true;
            } else if (sum < target) {
                left++;
            } else {
                right--;
            }
        }

        return false;
    }

    // 2. Sliding Window
    static int maxSum(int[] arr, int k) {
        if (k > arr.length) {
            return -1;
        }

        int windowSum = 0;

        for (int i = 0; i < k; i++) {
            windowSum += arr[i];
        }

        int maxSum = windowSum;

        for (int i = k; i < arr.length; i++) {
            windowSum += arr[i];
            windowSum -= arr[i - k];

            maxSum = Math.max(maxSum, windowSum);
        }

        return maxSum;
    }

    // 3. Prefix Sum
    static int rangeSum(int[] prefix, int left, int right) {
        if (left == 0) {
            return prefix[right];
        }

        return prefix[right] - prefix[left - 1];
    }

    // 4. Hashing
    static void frequency(int[] arr) {
        HashMap<Integer, Integer> map = new HashMap<>();

        for (int num : arr) {
            map.put(num, map.getOrDefault(num, 0) + 1);
        }

        System.out.println("Frequency: " + map);
    }

    // 5. Binary Search
    static int binarySearch(int[] arr, int target) {
        int left = 0;
        int right = arr.length - 1;

        while (left <= right) {
            int mid = left + (right - left) / 2;

            if (arr[mid] == target) {
                return mid;
            } else if (arr[mid] < target) {
                left = mid + 1;
            } else {
                right = mid - 1;
            }
        }

        return -1;
    }

    public static void main(String[] args) {

        int[] arr = {2, 7, 11, 15, 3, 6};

        // Two Pointers
        System.out.println("Two Pointers:");
        System.out.println(twoSum(arr, 9));

        // Sliding Window
        int[] numbers = {2, 1, 5, 1, 3, 2};

        System.out.println("\nSliding Window:");
        System.out.println("Maximum sum = " + maxSum(numbers, 3));

        // Prefix Sum
        int[] data = {2, 4, 1, 5, 3};

        int[] prefix = new int[data.length];

        prefix[0] = data[0];

        for (int i = 1; i < data.length; i++) {
            prefix[i] = prefix[i - 1] + data[i];
        }

        System.out.println("\nPrefix Sum:");
        System.out.println("Sum from index 1 to 3 = "
                + rangeSum(prefix, 1, 3));

        // Hashing
        System.out.println("\nHashing:");
        frequency(new int[]{2, 3, 2, 4, 3, 2});

        // Binary Search
        int[] sorted = {1, 2, 3, 4, 5, 6, 7, 8, 9};

        System.out.println("\nBinary Search:");
        System.out.println("Index of 6 = "
                + binarySearch(sorted, 6));
    }
}
