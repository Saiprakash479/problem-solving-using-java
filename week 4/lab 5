import java.util.Scanner;

public class BankingTransactionSystem {

    static Scanner sc = new Scanner(System.in);

    static int accountNumber1 = 0;
    static String accountName1 = "";
    static double balance1 = 0;

    static int accountNumber2 = 0;
    static String accountName2 = "";
    static double balance2 = 0;

    static boolean account1Created = false;
    static boolean account2Created = false;

    public static void main(String[] args) {

        int choice;

        do {
            System.out.println("\n==============================");
            System.out.println(" BANKING TRANSACTION SYSTEM");
            System.out.println("==============================");
            System.out.println("1. Create Account");
            System.out.println("2. Deposit Money");
            System.out.println("3. Withdraw Money");
            System.out.println("4. Check Balance");
            System.out.println("5. Transfer Money");
            System.out.println("6. Display Account Details");
            System.out.println("7. Exit");
            System.out.print("Enter your choice: ");

            choice = sc.nextInt();

            switch (choice) {

                case 1:
                    createAccount();
                    break;

                case 2:
                    depositMoney();
                    break;

                case 3:
                    withdrawMoney();
                    break;

                case 4:
                    checkBalance();
                    break;

                case 5:
                    transferMoney();
                    break;

                case 6:
                    displayAccounts();
                    break;

                case 7:
                    System.out.println("Thank you for using the Banking System.");
                    break;

                default:
                    System.out.println("Invalid choice.");
            }

        } while (choice != 7);

        sc.close();
    }

    static void createAccount() {

        System.out.print("Enter Account Number: ");
        int number = sc.nextInt();

        sc.nextLine();

        System.out.print("Enter Account Holder Name: ");
        String name = sc.nextLine();

        System.out.print("Enter Initial Balance: ");
        double balance = sc.nextDouble();

        if (balance < 0) {
            System.out.println("Balance cannot be negative.");
            return;
        }

        if (!account1Created) {

            accountNumber1 = number;
            accountName1 = name;
            balance1 = balance;
            account1Created = true;

            System.out.println("Account 1 created successfully.");

        } else if (!account2Created) {

            accountNumber2 = number;
            accountName2 = name;
            balance2 = balance;
            account2Created = true;

            System.out.println("Account 2 created successfully.");

        } else {

            System.out.println("Maximum 2 accounts can be created.");
        }
    }

    static int findAccount(int number) {

        if (account1Created && accountNumber1 == number) {
            return 1;
        }

        if (account2Created && accountNumber2 == number) {
            return 2;
        }

        return 0;
    }

    static void depositMoney() {

        System.out.print("Enter Account Number: ");
        int number = sc.nextInt();

        int account = findAccount(number);

        if (account == 0) {
            System.out.println("Account not found.");
            return;
        }

        System.out.print("Enter Deposit Amount: ");
        double amount = sc.nextDouble();

        if (amount <= 0) {
            System.out.println("Invalid amount.");
            return;
        }

        if (account == 1) {
            balance1 += amount;
            System.out.println("Deposit successful.");
            System.out.println("New Balance: " + balance1);
        } else {
            balance2 += amount;
            System.out.println("Deposit successful.");
            System.out.println("New Balance: " + balance2);
        }
    }

    static void withdrawMoney() {

        System.out.print("Enter Account Number: ");
        int number = sc.nextInt();

        int account = findAccount(number);

        if (account == 0) {
            System.out.println("Account not found.");
            return;
        }

        System.out.print("Enter Withdrawal Amount: ");
        double amount = sc.nextDouble();

        if (amount <= 0) {
            System.out.println("Invalid amount.");
            return;
        }

        if (account == 1) {

            if (amount > balance1) {
                System.out.println("Insufficient balance.");
            } else {
                balance1 -= amount;
                System.out.println("Withdrawal successful.");
                System.out.println("Remaining Balance: " + balance1);
            }

        } else {

            if (amount > balance2) {
                System.out.println("Insufficient balance.");
            } else {
                balance2 -= amount;
                System.out.println("Withdrawal successful.");
                System.out.println("Remaining Balance: " + balance2);
            }
        }
    }

    static void checkBalance() {

        System.out.print("Enter Account Number: ");
        int number = sc.nextInt();

        int account = findAccount(number);

        if (account == 0) {
            System.out.println("Account not found.");
            return;
        }

        if (account == 1) {
            System.out.println("Account Holder: " + accountName1);
            System.out.println("Balance: " + balance1);
        } else {
            System.out.println("Account Holder: " + accountName2);
            System.out.println("Balance: " + balance2);
        }
    }

    static void transferMoney() {

        System.out.print("Enter Sender Account Number: ");
        int sender = sc.nextInt();

        System.out.print("Enter Receiver Account Number: ");
        int receiver = sc.nextInt();

        if (sender == receiver) {
            System.out.println("Sender and receiver cannot be the same.");
            return;
        }

        int senderAccount = findAccount(sender);
        int receiverAccount = findAccount(receiver);

        if (senderAccount == 0 || receiverAccount == 0) {
            System.out.println("Invalid account number.");
            return;
        }

        System.out.print("Enter Transfer Amount: ");
        double amount = sc.nextDouble();

        if (amount <= 0) {
            System.out.println("Invalid amount.");
            return;
        }

        if (senderAccount == 1 && receiverAccount == 2) {

            if (amount > balance1) {
                System.out.println("Insufficient balance.");
            } else {
                balance1 -= amount;
                balance2 += amount;

                System.out.println("Transfer successful.");
                System.out.println("Sender Balance: " + balance1);
            }

        } else if (senderAccount == 2 && receiverAccount == 1) {

            if (amount > balance2) {
                System.out.println("Insufficient balance.");
            } else {
                balance2 -= amount;
                balance1 += amount;

                System.out.println("Transfer successful.");
                System.out.println("Sender Balance: " + balance2);
            }
        }
    }

    static void displayAccounts() {

        if (!account1Created && !account2Created) {
            System.out.println("No accounts created.");
            return;
        }

        if (account1Created) {

            System.out.println("\n--- Account 1 ---");
            System.out.println("Account Number: " + accountNumber1);
            System.out.println("Account Holder: " + accountName1);
            System.out.println("Balance: " + balance1);
        }

        if (account2Created) {

            System.out.println("\n--- Account 2 ---");
            System.out.println("Account Number: " + accountNumber2);
            System.out.println("Account Holder: " + accountName2);
            System.out.println("Balance: " + balance2);
        }
    }
}

